[Unit]
Description=GARIL AI all-in-one (Fastify API + static Next.js export)
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/garil-ai

Environment=NODE_ENV=production
EnvironmentFile=-/var/www/garil-ai/backend/.env
EnvironmentFile=-/var/www/garil-ai/.env

ExecStart=/usr/bin/node backend/dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/garil-ai/backend/backups

[Install]
WantedBy=multi-user.target
