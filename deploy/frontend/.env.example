# Frontend build-time env (Next.js public)
# Coolify: set these as Build-time / ARG variables for deploy/frontend/Dockerfile
#
# Same-origin (recommended): leave empty — Traefik/nginx proxies /api + /ws on the web domain.
# NEXT_PUBLIC_FEYNMAN_BACKEND=
#
# Split domains only (must be HTTPS if the site is HTTPS):
# NEXT_PUBLIC_FEYNMAN_BACKEND=https://api.garilai.com

# Optional (research note sync)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
