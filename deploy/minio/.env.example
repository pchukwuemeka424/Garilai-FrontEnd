# Copy to deploy/minio/.env (never commit real secrets)

# MinIO root (console admin) — use long random values
MINIO_ROOT_USER=gariladmin
MINIO_ROOT_PASSWORD=change-me-minio-root-password

# Public HTTPS URLs (behind Coolify Traefik / Cloudflare)
MINIO_SERVER_URL=https://s3.garilai.com
MINIO_BROWSER_REDIRECT_URL=https://minio.garilai.com

# Default bucket + app credentials (created by minio-init)
MINIO_BUCKET=garil
MINIO_ACCESS_KEY=garilapp
MINIO_SECRET_KEY=change-me-minio-app-secret

# Optional DNS hostnames used by setup-vps.sh Traefik routes
S3_API_HOST=s3.garilai.com
S3_CONSOLE_HOST=minio.garilai.com

# --- Copy into backend/.env (or Coolify backend env) ---
# S3_ENDPOINT=https://s3.garilai.com
# S3_REGION=us-east-1
# S3_BUCKET=garil
# S3_ACCESS_KEY=<MINIO_ACCESS_KEY above>
# S3_SECRET_KEY=<MINIO_SECRET_KEY above>
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://s3.garilai.com
